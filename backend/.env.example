# Tavily is required for the review-search integration.
TAVILY_API_KEY=
GOOGLE_BOOKS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=90
GEMINI_FALLBACK_MODELS=gemini-3.6-flash
GPT_OSS_BASE_URL=https://integrate.api.nvidia.com/v1
GPT_OSS_API_KEY=
GPT_OSS_MODEL=openai/gpt-oss-20b
GPT_OSS_CONNECT_TIMEOUT_SECONDS=15
GPT_OSS_READ_TIMEOUT_SECONDS=45
OPEN_LIBRARY_USER_AGENT="NovelMatch/0.1 (contact: your-email@example.com)"
TAVILY_REVIEW_DOMAINS=mebmarket.com,pantip.com,novel.dek-d.com,app.thestorygraph.com,goodreads.com
